# CloseLoop Environment Variables
# Copy this file to .env and fill in your keys
# Never commit .env to version control

# Razorpay Test Credentials
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# LLM Provider for Tier 4 (choose one)
# Option A: NVIDIA Nemotron 3 Ultra
NEMOTRON_API_KEY=nvapi-xxxxxxxxxxxx
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1  # optional, defaults to NVIDIA endpoint

# Option B: OpenRouter (supports multiple models)
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1  # if using OpenRouter

# Option C: Anthropic Direct
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Option D: OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxx